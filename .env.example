# Frontend values are public build configuration, never credentials.
VITE_BASE_PATH=/part-c-textbook/
VITE_API_BASE_URL=https://your-neon-function-host
# Backend CORS origin (no repository path).
FRONTEND_ORIGINS=https://habibh0.github.io
# Neon injects DATABASE_URL into the deployed Function.
# Pull local credentials with: npx neon env pull --file .env.local
